* { font-family: 'Segoe UI', 'Microsoft YaHei UI'; font-size: 14px; color: #243b32; }
QMainWindow, QWidget#canvas, QScrollArea, QWidget#sheet, QWidget#hero { background: #f8faf6; }
QWidget#rail { background: #1c302a; }
QLabel { background: transparent; }
QLabel#brand { font-size: 20px; font-weight: 700; color: #f5f9ed; }
QLabel#railCaption { color: #99b0a3; font-size: 12px; }
QLabel#railMeta { color: #d1dfd4; font-size: 13px; }
QLabel#eyebrow { color: #55765e; font-size: 12px; font-weight: 700; }
QLabel#title { font-size: 16px; font-weight: 650; }
QLabel#heroTitle { font-size: 34px; font-weight: 700; color: #203d30; }
QLabel#hint { color: #64736b; }
QLabel#micro { font-size: 12px; color: #718078; }
QLabel#notice { font-size: 13px; color: #834622; }
QLabel#speaker { font-size: 13px; font-weight: 650; color: #385545; }
QLabel#pill { color: #345f44; background: #e5efdf; border-radius: 9px; padding: 4px 9px; font-size: 12px; }
QFrame#divider { background: #dae1d8; max-height: 1px; min-height: 1px; }
QFrame#railDivider { background: #385045; max-height: 1px; min-height: 1px; }
QPushButton, QToolButton { border: 1px solid transparent; border-radius: 8px; background: transparent; padding: 6px 10px; }
QPushButton:hover, QToolButton:hover { background: #eaf0e7; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus { border: 1px solid #7e9d73; }
QPushButton:disabled { color: #96a398; }
QPushButton#new { background: #cbe99f; color: #233b2a; text-align: left; font-weight: 650; padding: 10px 15px; }
QPushButton#new:hover { background: #d9f4b4; }
QLineEdit#search { background: #263b32; color: #e3eae1; border: 1px solid #405449; padding: 8px 9px; border-radius: 8px; }
QListWidget#history { background: transparent; border: none; outline: none; color: #dae5da; }
QListWidget#history::item { padding: 8px 6px; border-radius: 6px; }
QListWidget#history::item:hover { background: #273f34; }
QListWidget#history::item:selected { background: #3a5143; color: white; }
QPushButton#railAction { color: #e0eade; text-align: left; padding: 8px 6px; }
QPushButton#railAction:hover { background: #314a3d; }
QPushButton#chip { background: #eff3ec; padding: 5px 9px; font-size: 12px; color: #47624d; }
QPushButton#chip:hover { background: #e5eddf; }
QPushButton#send { background: #345d45; color: white; padding: 6px 13px; font-weight: 650; }
QPushButton#send:hover { background: #264d37; }
QPushButton#send:disabled { background: #dce5d7; color: #6c806b; }
QPushButton#suggest { border: 1px solid #d7e1d4; border-radius: 11px; background: #ffffff; text-align: left; }
QPushButton#suggest:hover { background: #edf4e7; border: 1px solid #b6cba8; }
QFrame#composer { background: #ffffff; border: 1px solid #bdcdbb; border-radius: 15px; }
QLabel#permissionLabel { color: #294a38; font-weight: 650; }
QComboBox#permissionProfile { background: #edf4e8; color: #253f2f; border: 1px solid #9eb299; border-radius: 6px; padding: 3px 8px; min-height: 22px; }
QComboBox#permissionProfile:hover, QComboBox#permissionProfile:focus { border-color: #547754; }
QComboBox#permissionProfile:disabled { background: #f1f3ef; color: #435546; border-color: #cad4c8; }
QComboBox#permissionProfile[highRisk="true"] { background: #fbeadd; color: #813411; border-color: #c88861; }
QFrame#userCard { background: #e8f1e0; border-radius: 12px; }
QFrame#activity { background: #edf2eb; border-radius: 7px; }
QFrame#errorCard { background: #f9ece0; border-radius: 9px; }
QFrame#drawer { background: #f0f4ee; border-left: 1px solid #dae1d7; }
QPlainTextEdit#editor { background: transparent; border: none; padding: 0; font-size: 15px; }
QTextBrowser { background: transparent; border: none; selection-background-color: #bbd8ad; }
QListWidget#jobs { background: #fbfcf9; border: 1px solid #d5dfd1; border-radius: 8px; }
QListWidget#jobs::item { padding: 8px; border-radius: 6px; }
QListWidget#jobs::item:selected { background: #dcead3; color: #253d2c; }
QScrollArea { border: none; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 1px; }
QScrollBar::handle:vertical { background: #bdc9bd; border-radius: 3px; min-height: 22px; }
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical { background: transparent; }
QMenu, QDialog { background: #fafcf8; }
QMenu { border: 1px solid #c5d2c1; padding: 5px; }
QMenu::item { padding: 7px 14px; border-radius: 4px; }
QMenu::item:selected { background: #e0edda; color: #203b2b; }
QToolTip { background: #243b30; color: white; border: none; padding: 5px; }
QPushButton#risk, QLabel#riskWarning { background: #fce8d9; color: #823611; padding: 8px; border-radius: 7px; }
QWidget#catalogPage { background: #f8faf6; }
QTabBar#catalogTabs::tab { background: #e9efe6; color: #536957; border: none; padding: 8px 9px; }
QTabBar#catalogTabs::tab:selected { background: #335742; color: white; }
QWidget#catalogPage QComboBox { background: white; border: 1px solid #c2d0bd; border-radius: 6px; padding: 5px 8px; }
